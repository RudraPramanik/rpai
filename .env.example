# Portfolio API + RAG + Chat + Voice (Phases 2–7)

# Content / API
DATA_DIR=
CORS_ORIGINS=http://localhost:3000

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio_knowledge

# Gemini (LiteLLM). Prefer GEMINI_API_KEY — GEMINAI_API_KEY / GENAI_API_KEY also accepted.
# Do not commit real keys.
GEMINI_API_KEY=
# Optional aliases:
# GEMINAI_API_KEY=
# GENAI_API_KEY=
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Free-tier Gemini chat — prefer GEMINI_LLM_API_MODEL (LLM_MODEL also works)
GEMINI_LLM_API_MODEL=gemini/gemini-3.1-flash-lite

# Voice STT — NVIDIA NIM / NVCF (Parakeet). Not Groq.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
STT_MODEL=nvidia/parakeet-ctc-1.1b-asr
# OpenAI-compatible NVCF ASR base (Parakeet CTC 1.1B). Override to swap STT endpoints.
STT_API_BASE=https://1598d209-5e27-4d3c-8079-4751568b1081.invocation.api.nvcf.nvidia.com/v1
STT_LANGUAGE=en-US
STT_MAX_UPLOAD_BYTES=5242880
