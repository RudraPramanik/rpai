# Portfolio API + RAG (Phase 4)

# Content / API
DATA_DIR=
CORS_ORIGINS=http://localhost:3000

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio_knowledge

# Model providers (LiteLLM). Prefer GEMINI_API_KEY in the environment — do not commit real keys.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini/text-embedding-004
# text-embedding-004 default output size; set empty to probe on collection create
EMBEDDING_DIMENSIONS=768
# Placeholder for Phase 5 chat — not required for ingest/retrieve
LLM_MODEL=gemini/gemini-2.0-flash
